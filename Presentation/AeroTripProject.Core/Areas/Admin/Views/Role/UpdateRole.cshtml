@model ResultAppRole

@{
    ViewData["Title"] = "Rolu Yenilə";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>Rolu Yenilə</h1>

<form method="post" asp-action="UpdateRole" asp-controller="Role">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Rolun Adı</label>
        <input asp-for="Name"
               class="form-control"
               placeholder="Rol adını daxil edin" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Yenilə
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Geri Qayıt
    </a>

</form>
