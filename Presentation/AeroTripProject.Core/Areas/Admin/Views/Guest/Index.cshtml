@model List<ResultUsers>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>İstifadəçi Siyahısı</h1>

<table class="table table-bordered">

    <tr>
       
        <th>Ad Soyad</th>
        <th>İstifadəçi adı</th>
        <th>Şəkil</th>
        <th>Email</th>
        
        <th>Sil</th>
        <th>Yenilə</th>
        <th>Şərhlər</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
  
            <td>@item.NameSurname</td>
            <td>@item.Username</td>
            <td>
                <img src="/userimages/@item.ImageUrl"
                     style="width:70px;
                        height:70px;
                        border-radius:50%;
                        object-fit:cover;" />
            </td>
            <td>@item.Email</td>
            
            <td>
                <a href="/Admin/Guest/DeleteGuest/@item.Id" class="btn btn-danger">
                    Sil
                </a>
            </td>
            <td>
                <a href="/Admin/Guest/EditGuest/@item.Id" class="btn btn-warning">
                    Yenilə
                </a>
            </td>
            <td>
                <a href="/Admin/Guest/CommentGuest/@item.Id" class="btn btn-info">
                    Şərhlər
                </a>
            </td>

        </tr>
    }

</table>
<a href="/Admin/Guest/CreateGuest/" class="btn btn-success">
    Yeni İstifadəçi
</a>

