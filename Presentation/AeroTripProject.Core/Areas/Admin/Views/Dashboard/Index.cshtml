
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}


<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        @await Component.InvokeAsync("AdminDashboardBanner")
        @await Component.InvokeAsync("AdminDashboardCard1")
        <!-- Total Revenue -->
        @await Component.InvokeAsync("AdminDashboardTotalRevenue")
        <!--/ Total Revenue -->
        @await Component.InvokeAsync("AdminDashboardCard2")
    </div>
    <div class="row">
        <!-- Order Statistics -->
        @await Component.InvokeAsync("AdminDashboardDestinationStatistic")
        <!--/ Order Statistics -->
        <!-- Expense Overview -->
        @await Component.InvokeAsync("AdminDashboardGuest")
        <!--/ Expense Overview -->
        <!-- Transactions -->
        @await Component.InvokeAsync("AdminDashboardGuide")
        <!--/ Transactions -->
    </div>
</div>




