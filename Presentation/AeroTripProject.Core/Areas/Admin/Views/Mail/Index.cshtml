@model MailRequest

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>Mail Göndərmə Səhifəsi</h1>

@if (TempData["MailSuccess"] != null)
{
    <div id="mailSuccessAlert" class="alert alert-success">
        @TempData["MailSuccess"]
    </div>
}

<form method="post" asp-action="SendMail" asp-controller="Mail">

    <div class="form-group mb-3">
        <label asp-for="Name">Göndərən Adı</label>
        <input asp-for="Name"
               class="form-control"
               placeholder="Ad daxil edin" />

        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ReceiverMail">Qəbul edən Mail</label>
        <input asp-for="ReceiverMail"
               class="form-control"
               placeholder="Qəbul edən email daxil edin" />

        <span asp-validation-for="ReceiverMail" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Subject">Mövzu</label>
        <input asp-for="Subject"
               class="form-control"
               placeholder="Mövzu daxil edin" />

        <span asp-validation-for="Subject" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Body">Mesaj</label>

        <textarea asp-for="Body"
                  class="form-control"
                  rows="6"
                  placeholder="Mesajınızı yazın"></textarea>

        <span asp-validation-for="Body" class="text-danger"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Mail Göndər
    </button>

</form>

<script>
    setTimeout(function () {
        var alert = document.getElementById("mailSuccessAlert");
        if (alert) {
            alert.style.display = "none";
        }
    }, 2000);
</script>