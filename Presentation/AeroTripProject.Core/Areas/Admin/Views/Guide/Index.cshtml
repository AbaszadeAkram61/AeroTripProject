@model List<ResultGuide>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>Rəhbər Siyahısı</h1>

<table class="table table-bordered">

    <tr>
      
        <th>Şəkil</th>
        <th>Ad Soyad</th>
        <th>Açıqlama</th>
        <th>Status</th>
        <th>Yenilə</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                <img src="@item.Image"
                     alt="Rəhbər Şəkli"
                     style="width:70px;
                    height:70px;
                    object-fit:cover;
                    border-radius:50%;
                    border:3px solid #0d6efd;
                    padding:2px;
                    box-shadow:0 2px 8px rgba(0,0,0,0.2);" />
            </td>
            <td>@item.Name</td>
            <td>@item.Description</td>
            @if (item.Status == true)
            {
                <td>
                    <a href="/Admin/Guide/ChangeStatus?id=@item.Id&status=false"
                       class="btn btn-warning">
                        Passiv Et
                    </a>
                </td>
            }
            else
            {
                <td>
                    <a href="/Admin/Guide/ChangeStatus?id=@item.Id&status=true"
                       class="btn btn-info">
                        Aktiv Et
                    </a>
                </td>
            }
            <td><a href="/Admin/Guide/EditGuide/@item.Id" class="btn btn-success">Yenilə</a></td>
        </tr>
    }

</table>
<a href="/Admin/Guide/CreateGuide" class="btn btn-primary">Rəhbər Yarat</a>

