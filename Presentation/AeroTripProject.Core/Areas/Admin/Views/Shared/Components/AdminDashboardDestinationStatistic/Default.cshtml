@model List<ResultDestination>

@{
    int pageSize = 4;

    int currentPage = Context.Request.Query["destinationPage"].ToString() == ""
        ? 1
        : Convert.ToInt32(Context.Request.Query["destinationPage"]);

    int totalItems = Model.Count();

    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);

    var pagedModel = Model
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();
}

<div class="col-md-6 col-lg-4 col-xl-4 order-0 mb-4">

    <div class="card h-100">

        <div class="card-header pb-0">
            <div class="card-title mb-0">
                <h5 class="m-0 me-2">Tur İstiqamətləri</h5>

            </div>
        </div>

        <div class="card-body mt-3">

            @foreach (var item in pagedModel)
            {
                <div class="d-flex align-items-center mb-4">

                    <img src="@item.Image"
                         alt="Destination"
                         style="width:70px;
                height:70px;
                object-fit:cover;
                object-position:center;
                border-radius:50%;
                border:3px solid #0d6efd;
                padding:2px;
                margin-right:15px;
                box-shadow:0 2px 8px rgba(0,0,0,0.2);" />

                    <div>
                        <h6 class="mb-1">
                            @item.City
                        </h6>

                        <small class="text-muted">
                            Tur istiqaməti
                        </small>
                    </div>

                </div>
            }

            <nav class="mt-3">
                <ul class="pagination pagination-sm mb-0">

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">

                            <a class="page-link"
                               href="?destinationPage=@i">
                                @i
                            </a>

                        </li>
                    }

                </ul>
            </nav>

        </div>

    </div>

</div>