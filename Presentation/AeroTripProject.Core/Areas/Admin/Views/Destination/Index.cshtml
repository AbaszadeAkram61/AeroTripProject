@model List<ResultDestination>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>Tur İstiqamətləri</h1>

<table class="table table-bordered">
    <tr>
       
        <th>Şəhər</th>
        <th>Qiymət</th>
        <th>Tutum</th>
       
        <th>Saytda Görünsün</th>
        <th>Sil</th>
        <th>Yenilə</th>
        
    </tr>
    @foreach (var item in Model)
    {
        <tr>
          
            <td>@item.City</td>
            <td>@item.Price Azn</td>
            <td>@item.Capacity</td>

            <td><a href="/Destination/DestinationDetails/@item.Id" target="_blank" class="btn btn-info">Saytda Görünsün</a></td>
            <td><a href="/Admin/Destination/DeleteDestination/@item.Id" class="btn btn-danger">Sil</a></td>
            <td><a href="/Admin/Destination/UpdateDestination/@item.Id" class="btn btn-success">Yenilə</a></td>
            

        </tr>
    }
</table>

<a href="/Admin/Destination/AddDestination" class="btn btn-primary">Yeni Tur İstiqaməti</a>

