@model CreateReservation

@{
    ViewData["Title"] = "NewReservation";
    Layout = "~/Areas/Member/Views/Shared/_UserLayout.cshtml";
}

<style>

    .reservation-form-card {
        background: #fff;
        padding: 40px;
        border-radius: 30px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.07);
    }

    .reservation-title {
        font-size: 42px;
        font-weight: 800;
        color: #344767;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 24px;
    }

        .form-group label {
            color: #344767;
            font-weight: 700;
            margin-bottom: 10px;
            display: block;
        }

    .form-control {
        height: 54px;
        border-radius: 16px;
        border: 1px solid #d9dee7;
        padding-left: 18px;
        color: #344767;
        font-size: 16px;
        transition: .3s;
    }

        .form-control:focus {
            border-color: #d6009f;
            box-shadow: 0 0 0 3px rgba(214,0,159,0.12);
        }

    textarea.form-control {
        height: 180px;
        padding-top: 15px;
        resize: none;
    }

    .btn-reservation {
        background: linear-gradient(135deg,#d6009f,#b100d4);
        border: none;
        border-radius: 14px;
        padding: 14px 30px;
        color: white;
        font-weight: 800;
        font-size: 15px;
        box-shadow: 0 10px 25px rgba(214,0,159,0.25);
        transition: .3s;
    }

        .btn-reservation:hover {
            transform: translateY(-2px);
            color: white;
        }

    .text-danger {
        font-size: 14px;
        margin-top: 6px;
        display: block;
    }

    @@media(max-width:768px) {

        .reservation-title {
            font-size: 32px;
        }

        .reservation-form-card {
            padding: 20px;
        }
    }

</style>

<div class="reservation-form-card">

    <h2 class="reservation-title">
        Yeni Rezervasiya
    </h2>

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <form asp-action="NewReservation"
          asp-controller="Reservation"
          asp-area="Member"
          method="post">

        <div class="form-group">

            <label asp-for="DestinationId">
                Gediləcək İstiqamətlər
            </label>

            <select asp-for="DestinationId"
                    class="form-control"
                    asp-items="ViewBag.v1">

                <option value="">Seçin</option>

            </select>

            <span asp-validation-for="DestinationId"
                  class="text-danger"></span>

        </div>

        <div class="form-group">

            <label asp-for="PersonCount">
                Adam sayı
            </label>

            <input asp-for="PersonCount"
                   class="form-control"
                   placeholder="Adam sayı daxil edin" />

            <span asp-validation-for="PersonCount"
                  class="text-danger"></span>

        </div>

        <div class="form-group">

            <label asp-for="ReservationDate">
                Rezervasiya tarixi seçin
            </label>

            <input asp-for="ReservationDate"
                   type="date"
                   class="form-control"
                   min="@DateTime.Now.ToString("yyyy-MM-dd")"
                   value="@DateTime.Now.ToString("yyyy-MM-dd")" />

            <span asp-validation-for="ReservationDate"
                  class="text-danger"></span>

        </div>

        <div class="form-group">

            <label asp-for="Description">
                Açıqlama
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      placeholder="Əlavə qeydlərinizi daxil edin"></textarea>

            <span asp-validation-for="Description"
                  class="text-danger"></span>

        </div>

        <button type="submit" class="btn-reservation">

            <i class="ni ni-send"></i>
            Rezervasiya et

        </button>

    </form>

</div>

