@model List<ResultReservation>

@{
    ViewData["Title"] = "MyApprovalReservation";
    Layout = "~/Areas/Member/Views/Shared/_UserLayout.cshtml";
}



<div class="reservation-card">

    <div class="reservation-header">

        <h2>Təsdiq Gözləyən Rezervasiyalar</h2>

        <div class="reservation-count reservation-count-waiting">
            @Model.Count Rezervasiya
        </div>

    </div>

    <div class="table-responsive">

        <table class="table reservation-table">

            <thead>
                <tr>
                    <th>İstiqamət</th>
                    <th>Şəxs Sayı</th>
                    <th>Rezervasiya Tarixi</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>

                            <div class="destination-box">

                                <div class="destination-icon destination-icon-waiting">
                                    <i class="ni ni-time-alarm"></i>
                                </div>

                                @item.DestinationName

                            </div>

                        </td>

                        <td>

                            <span class="person-badge person-badge-waiting">
                                @item.PersonCount nəfər
                            </span>

                        </td>

                        <td>

                            <div class="date-box date-box-waiting">
                                @item.ReservationDate.ToShortDateString()
                            </div>

                        </td>

                        <td>

                            <span class="status-waiting">
                                @item.StatusString
                            </span>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>