@model List<ResultReservation>

@{
    ViewData["Title"] = "MyCurrentReservation";
    Layout = "~/Areas/Member/Views/Shared/_UserLayout.cshtml";
}

<style>

    .reservation-card {
        background: #fff;
        padding: 35px;
        border-radius: 30px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.07);
    }

    .reservation-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 15px;
    }

        .reservation-header h2 {
            font-size: 42px;
            font-weight: 800;
            color: #344767;
            margin: 0;
        }

    .reservation-count {
        background: linear-gradient(135deg,#f3e8ff,#fdf4ff);
        color: #b100d4;
        padding: 12px 22px;
        border-radius: 30px;
        font-weight: 700;
        font-size: 15px;
    }

    .reservation-table {
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0 12px;
    }

        .reservation-table thead tr {
            background: transparent;
        }

        .reservation-table th {
            border: none !important;
            color: #7b809a;
            font-size: 15px;
            font-weight: 700;
            padding: 14px 18px !important;
        }

        .reservation-table td {
            background: #fff;
            border: none !important;
            padding: 22px 18px !important;
            vertical-align: middle;
        }

        .reservation-table tbody tr {
            box-shadow: 0 8px 25px rgba(0,0,0,0.05);
            border-radius: 18px;
            transition: .3s;
        }

            .reservation-table tbody tr:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 30px rgba(177,0,212,0.12);
            }

            .reservation-table tbody tr td:first-child {
                border-top-left-radius: 18px;
                border-bottom-left-radius: 18px;
            }

            .reservation-table tbody tr td:last-child {
                border-top-right-radius: 18px;
                border-bottom-right-radius: 18px;
            }

    .destination-box {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        color: #344767;
        font-size: 16px;
    }

    .destination-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: linear-gradient(135deg,#d6009f,#7b2ff7);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .person-badge {
        background: #eef2ff;
        color: #4f46e5;
        padding: 9px 16px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 14px;
    }

    .date-box {
        color: #344767;
        font-weight: 600;
    }

    .status-active {
        background: #dcfce7;
        color: #16a34a;
        padding: 9px 18px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 14px;
        display: inline-block;
    }

    @@media(max-width:768px) {

        .reservation-header h2 {
            font-size: 30px;
        }

        .reservation-card {
            padding: 20px;
        }

        .reservation-table {
            min-width: 700px;
        }
    }

</style>

<div class="reservation-card">

    <div class="reservation-header">

        <h2>Aktiv Rezervasiyalar</h2>

        <div class="reservation-count">
            @Model.Count Rezervasiya
        </div>

    </div>

    <div class="table-responsive">

        <table class="table reservation-table">

            <thead>
                <tr>
                    <th>İstiqamət</th>
                    <th>Şəxs Sayı</th>
                    <th>Rezervasiya Tarixi</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>

                            <div class="destination-box">

                                <div class="destination-icon">
                                    <i class="ni ni-send"></i>
                                </div>

                                @item.DestinationName

                            </div>

                        </td>

                        <td>

                            <span class="person-badge">
                                @item.PersonCount nəfər
                            </span>

                        </td>

                        <td>

                            <div class="date-box">
                                @item.ReservationDate.ToShortDateString()
                            </div>

                        </td>

                        <td>

                            <span class="status-active">
                                @item.StatusString
                            </span>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>