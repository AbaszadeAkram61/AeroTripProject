@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="en">

@await Component.InvokeAsync("UserHead")

<body class="g-sidenav-show  bg-gray-100">
    @await Component.InvokeAsync("UserSideBar")
 
    <main class="main-content position-relative max-height-vh-100 h-100 mt-1 border-radius-lg ">
        <!-- Navbar -->
        <button type="button" id="memberMenuBtn" class="member-menu-btn d-xl-none">
            <span></span>
            <span></span>
            <span></span>
        </button>
        
        <!-- End Navbar -->
        <div class="container-fluid py-4">
            @RenderBody()
           
        </div>
    </main>
  
    <!--   Core JS Files   -->
    @await Component.InvokeAsync("UserScript")
</body>

</html>



