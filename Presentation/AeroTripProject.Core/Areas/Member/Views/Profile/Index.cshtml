@model EditUserViewModel
@{
    ViewData["Title"] = "Profilim";
    Layout = "~/Areas/Member/Views/Shared/_UserLayout.cshtml";
}




<div class="profile-page">

    <div class="profile-wrapper">

        <div class="profile-card">

            <div class="profile-cover"></div>

            <div class="profile-info">

                <div class="avatar-box" onclick="openImage()">

                    <img id="avatarPreview"
                         src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "" : "/userimages/" + Model.ImageUrl)"
                         alt="Profil Şəkli"
                         class="avatar-img @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")" />

                    <div id="avatarText"
                         class="avatar-empty @(string.IsNullOrEmpty(Model.ImageUrl) ? "" : "d-none")">
                        ?
                    </div>

                </div>

                <div class="profile-name" id="previewName">
                    @(string.IsNullOrEmpty(Model.Username) ? "İstifadəçi" : Model.Username)
                </div>

              

                <div class="member-badge">
                    AeroTrip Premium Üzv
                </div>

                <div class="profile-details-box">

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="ni ni-email-83"></i>
                        </div>

                        <div class="detail-content">

                            <div class="detail-text email-text">
                                @Model.Email
                            </div>

                            <div class="detail-sub">
                                Email təsdiqlənib
                            </div>

                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="ni ni-lock-circle-open"></i>
                        </div>

                        <div>
                            <div class="detail-text">
                                Hesab Təhlükəsizliyi
                            </div>
                            <div class="detail-sub">
                                Yüksək
                            </div>
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="ni ni-calendar-grid-58"></i>
                        </div>

                        <div>
                            <div class="detail-text">
                                Qoşulma Tarixi
                            </div>
                            <div class="detail-sub">
                               @DateTime.Now.Year
                            </div>
                        </div>
                    </div>

                </div>

               

            </div>

        </div>

        <div class="form-card">


            @if (TempData["SuccessMessage"] != null)
            {
                <div id="successAlert" class="alert alert-success mb-4">
                    @TempData["SuccessMessage"]
                </div>
            }

         

           
            <form method="post"
                  asp-action="UpdateUser"
                  asp-controller="Profile"
                  enctype="multipart/form-data">


                <input type="hidden" asp-for="ImageUrl" />

                <div class="form-group">
                    <label>Adınız Soyadınız</label>
                    <input type="text"
                           asp-for="NameSurname"
                           id="nameInput"
                           class="form-control"
                           placeholder="Ad soyad daxil edin" />
                    <span asp-validation-for="NameSurname" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Email Ünvanınız</label>
                    <input type="email"
                           asp-for="Email"
                           class="form-control"
                           placeholder="Email daxil edin" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>İstifadəçi Adı</label>

                    <div class="username-input-wrapper">
                       <span class="username-symbol">@@</span>

                        <input type="text"
                               asp-for="Username"
                               id="usernameInput"
                               class="form-control username-input"
                               placeholder="İstifadəçi adı daxil edin" />
                    </div>

                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="custom-file-box">

                    <label for="imageInput" class="custom-file-btn">
                        <i class="ni ni-image"></i>
                        Şəkil Seç
                    </label>

                    <span id="selectedFileName" class="selected-file-name">
                        Şəkil seçilməyib
                    </span>

                    <input type="file"
                           asp-for="Image"
                           id="imageInput"
                           accept="image/*"
                           hidden />

                </div>

                <div class="form-group">
                    <label>Yeni Parol</label>
                    <input type="password"
                           asp-for="Password"
                           class="form-control"
                           placeholder="Yeni parol daxil edin" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Parol Təkrarı</label>
                    <input type="password"
                           asp-for="PasswordConfirm"
                           class="form-control"
                           placeholder="Parolu təkrar daxil edin" />
                    <span asp-validation-for="PasswordConfirm" class="text-danger"></span>
                </div>

                <div class="button-group">

                    <button type="submit" class="btn-update">
                        <i class="ni ni-settings-gear-65"></i>
                        Məlumatları Yenilə
                    </button>
                    <a href="#"
                       class="btn-delete"
                       data-bs-toggle="modal"
                       data-bs-target="#deleteModal">
                        Hesabı Sil
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
<script>

    const imageInput = document.getElementById("imageInput");
    const avatarPreview = document.getElementById("avatarPreview");
    const avatarText = document.getElementById("avatarText");
    const selectedFileName = document.getElementById("selectedFileName");

    imageInput.addEventListener("change", function () {

        const file = this.files[0];

        if (file) {

            selectedFileName.innerText = file.name;

            const reader = new FileReader();

            reader.onload = function (e) {

                avatarPreview.src = e.target.result;

                avatarPreview.classList.remove("d-none");

                avatarText.classList.add("d-none");

            };

            reader.readAsDataURL(file);

        }

    });

</script>

<div id="imageModal" class="image-modal" onclick="closeImage()">
    <img id="modalImage"
         src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "" : "/userimages/" + Model.ImageUrl)" />
</div>

<script>
    setTimeout(function () {

        let alertBox = document.getElementById("successAlert");

        if (alertBox) {

            alertBox.style.transition = "all 0.5s ease";
            alertBox.style.opacity = "0";

            setTimeout(function () {
                alertBox.remove();
            }, 500);
        }

    }, 2000);
</script>

<script>
    function openImage() {
        document.getElementById("imageModal").style.display = "flex";
    }

    function closeImage() {
        document.getElementById("imageModal").style.display = "none";
    }
</script>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Hesabı Sil
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                Hesabınızı silmək istədiyinizə əminsiniz?
                <br />
                Bu əməliyyat geri qaytarıla bilməz.
            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    İmtina Et
                </button>

                <a href="/Member/Profile/DeleteUser?id=@ViewBag.userId"
                   class="btn btn-danger">
                    Bəli, Sil
                </a>

            </div>

        </div>
    </div>
</div>