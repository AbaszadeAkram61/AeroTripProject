@model EditUserViewModel
@{
    ViewData["Title"] = "Profilim";
    Layout = "~/Areas/Member/Views/Shared/_UserLayout.cshtml";
}

<style>
    .profile-page {
        padding: 25px;
    }

    .profile-wrapper {
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 35px;
        align-items: stretch;
    }

    .profile-card,
    .form-card {
        height: 100%;
    }

    .form-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .profile-card {
        background: #fff;
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0,0,0,0.08);
        position: sticky;
        top: 20px;
    }

    .email-text {
        font-size: 14px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .profile-cover {
        height: 170px;
        background: linear-gradient(135deg, #d6009f, #7b2ff7);
        position: relative;
    }

        .profile-cover::after {
            content: '';
            position: absolute;
            width: 220px;
            height: 220px;
            border: 2px dashed rgba(255,255,255,0.15);
            border-radius: 50%;
            top: -70px;
            right: -40px;
        }

    .profile-info {
        text-align: center;
        padding: 0 25px 22px;
        margin-top: -160px;
    }

    .avatar-box {
        width: 145px;
        height: 145px;
        margin: 0 auto 18px;
        border-radius: 50%;
        border: 6px solid #fff;
        background: #f3f4f6;
        box-shadow: 0 15px 35px rgba(0,0,0,0.18);
        overflow: hidden;
        position: relative;
        transition: .3s;
    }

        .avatar-box:hover {
            transform: scale(1.03);
        }

    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .avatar-empty {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        font-weight: 700;
        color: #98a2b3;
    }

    .profile-name {
        font-size: 42px;
        font-weight: 800;
        color: #344767;
        margin-bottom: 5px;
    }

    .username-text {
        color: #7b809a;
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 18px;
    }

    .member-badge {
        display: inline-block;
        padding: 10px 22px;
        border-radius: 30px;
        background: #f3e8ff;
        color: #b100d4;
        font-weight: 700;
        margin-top: 0;
    }

    .profile-details-box {
        margin-top: 18px;
        border: 1px solid #edf0f5;
        border-radius: 20px;
        padding: 20px;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 22px;
        text-align: left;
    }

        .detail-item:last-child {
            margin-bottom: 0;
        }

    .detail-icon {
        min-width: 45px;
        width: 45px;
        height: 45px;
        border-radius: 14px;
        background: linear-gradient(135deg,#f3e8ff,#fdf4ff);
        color: #b100d4;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        box-shadow: 0 5px 15px rgba(177,0,212,0.12);
    }

    .detail-text {
        color: #344767;
        font-weight: 700;
        word-break: normal;
        overflow-wrap: anywhere;
        line-height: 1.4;
    }

    .detail-content {
        width: 100%;
        overflow: hidden;
    }

    .detail-sub {
        color: #7b809a;
        font-size: 14px;
        margin-top: 3px;
    }

    .password-card {
        margin-top: 20px;
        border: 1px solid #edf0f5;
        border-radius: 18px;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        transition: .3s;
    }

        .password-card:hover {
            background: #faf7ff;
        }

    .form-card {
        background: #fff;
        border-radius: 30px;
        padding: 40px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.07);
    }

    .form-title {
        font-size: 40px;
        font-weight: 800;
        color: #344767;
        margin-bottom: 8px;
    }

    .form-subtitle {
        color: #7b809a;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 24px;
    }

        .form-group label {
            color: #344767;
            font-weight: 700;
            margin-bottom: 10px;
        }

    .form-control {
        height: 42px;
        border-radius: 16px;
        border: 1px solid #d9dee7;
        padding-left: 18px;
        color: #344767;
        font-size: 16px;
        padding-top: 6px;
        padding-bottom: 6px;
    }

        .form-control:focus {
            border-color: #d6009f;
            box-shadow: 0 0 0 3px rgba(214,0,159,0.12);
        }

    .username-input-wrapper {
        position: relative;
    }

    .username-symbol {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #7b809a;
        font-weight: 700;
        z-index: 2;
    }

    .username-input {
        padding-left: 45px !important;
    }

    .custom-file-box {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .custom-file-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #f3e8ff;
        color: #b100d4;
        border-radius: 14px;
        padding: 12px 22px;
        font-weight: 700;
        cursor: pointer;
        margin: 0;
    }

        .custom-file-btn:hover {
            background: #ead5ff;
        }

    .selected-file-name {
        color: #7b809a;
        font-size: 14px;
    }

    .btn-update {
        background: linear-gradient(135deg, #d6009f, #b100d4);
        border: none;
        border-radius: 14px;
        padding: 12px 26px;
        color: #fff;
        font-weight: 700;
        font-size: 15px;
        box-shadow: 0 10px 25px rgba(214,0,159,0.22);
    }

        .btn-update:hover {
            color: #fff;
            transform: translateY(-2px);
        }


    .btn-delete {
        background: #fff0f0;
        color: #dc2626;
        padding: 12px 24px;
        border-radius: 14px;
        text-decoration: none;
        display: inline-block;
        font-weight: 700;
        margin-left: 10px;
        transition: .3s;
    }

        .btn-delete:hover {
            background: #dc2626;
            color: white;
        }
    @@media(max-width:992px) {
        .profile-wrapper {
            grid-template-columns: 1fr;
        }

        .form-title {
            font-size: 32px;
        }

        .profile-name {
            font-size: 32px;
        }
    }
</style>

<div class="profile-page">

    <div class="profile-wrapper">

        <div class="profile-card">

            <div class="profile-cover"></div>

            <div class="profile-info">

                <div class="avatar-box">

                    <img id="avatarPreview"
                         src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "" : "/userimages/" + Model.ImageUrl)"
                         alt="Profil Şəkli"
                         class="avatar-img @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")" />

                    <div id="avatarText"
                         class="avatar-empty @(string.IsNullOrEmpty(Model.ImageUrl) ? "" : "d-none")">
                        ?
                    </div>

                </div>

                <div class="profile-name" id="previewName">
                    @(string.IsNullOrEmpty(Model.Username) ? "İstifadəçi" : Model.Username)
                </div>

              

                <div class="member-badge">
                    AeroTrip Premium Üzv
                </div>

                <div class="profile-details-box">

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="ni ni-email-83"></i>
                        </div>

                        <div class="detail-content">

                            <div class="detail-text email-text">
                                @Model.Email
                            </div>

                            <div class="detail-sub">
                                Email təsdiqlənib
                            </div>

                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="ni ni-lock-circle-open"></i>
                        </div>

                        <div>
                            <div class="detail-text">
                                Hesab Təhlükəsizliyi
                            </div>
                            <div class="detail-sub">
                                Yüksək
                            </div>
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="ni ni-calendar-grid-58"></i>
                        </div>

                        <div>
                            <div class="detail-text">
                                Qoşulma Tarixi
                            </div>
                            <div class="detail-sub">
                               @DateTime.Now.Year
                            </div>
                        </div>
                    </div>

                </div>

               

            </div>

        </div>

        <div class="form-card">


            @if (TempData["SuccessMessage"] != null)
            {
                <div id="successAlert" class="alert alert-success mb-4">
                    @TempData["SuccessMessage"]
                </div>
            }

         

           
            <form method="post"
                  asp-action="UpdateUser"
                  asp-controller="Profile"
                  enctype="multipart/form-data">


                <input type="hidden" asp-for="ImageUrl" />

                <div class="form-group">
                    <label>Adınız Soyadınız</label>
                    <input type="text"
                           asp-for="NameSurname"
                           id="nameInput"
                           class="form-control"
                           placeholder="Ad soyad daxil edin" />
                    <span asp-validation-for="NameSurname" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Email Ünvanınız</label>
                    <input type="email"
                           asp-for="Email"
                           class="form-control"
                           placeholder="Email daxil edin" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>İstifadəçi Adı</label>

                    <div class="username-input-wrapper">
                       <span class="username-symbol">@@</span>

                        <input type="text"
                               asp-for="Username"
                               id="usernameInput"
                               class="form-control username-input"
                               placeholder="İstifadəçi adı daxil edin" />
                    </div>

                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="custom-file-box">

                    <label for="imageInput" class="custom-file-btn">
                        <i class="ni ni-image"></i>
                        Şəkil Seç
                    </label>

                    <span id="selectedFileName" class="selected-file-name">
                        Şəkil seçilməyib
                    </span>

                    <input type="file"
                           asp-for="Image"
                           id="imageInput"
                           accept="image/*"
                           hidden />

                </div>

                <div class="form-group">
                    <label>Yeni Parol</label>
                    <input type="password"
                           asp-for="Password"
                           class="form-control"
                           placeholder="Yeni parol daxil edin" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Parol Təkrarı</label>
                    <input type="password"
                           asp-for="PasswordConfirm"
                           class="form-control"
                           placeholder="Parolu təkrar daxil edin" />
                    <span asp-validation-for="PasswordConfirm" class="text-danger"></span>
                </div>

                <div class="button-group">

                    <button type="submit" class="btn-update">
                        <i class="ni ni-settings-gear-65"></i>
                        Məlumatları Yenilə
                    </button>
                    <a href="/Member/Profile/DeleteUser?id=@ViewBag.userId" class="btn-delete">
                        Hesabı Sil
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
<script>

    const imageInput = document.getElementById("imageInput");
    const avatarPreview = document.getElementById("avatarPreview");
    const avatarText = document.getElementById("avatarText");
    const selectedFileName = document.getElementById("selectedFileName");

    imageInput.addEventListener("change", function () {

        const file = this.files[0];

        if (file) {

            selectedFileName.innerText = file.name;

            const reader = new FileReader();

            reader.onload = function (e) {

                avatarPreview.src = e.target.result;

                avatarPreview.classList.remove("d-none");

                avatarText.classList.add("d-none");

            };

            reader.readAsDataURL(file);

        }

    });

</script>

<script>
    setTimeout(function () {

        let alertBox = document.getElementById("successAlert");

        if (alertBox) {

            alertBox.style.transition = "all 0.5s ease";
            alertBox.style.opacity = "0";

            setTimeout(function () {
                alertBox.remove();
            }, 500);
        }

    }, 2000);
</script>