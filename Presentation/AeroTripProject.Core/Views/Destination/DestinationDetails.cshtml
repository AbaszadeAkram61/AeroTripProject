@model ResultDestination

@{
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
}


<body>
  
  
    <section class="w3l-about-breadcrumb text-left">
        <div class="breadcrumb-bg breadcrumb-bg-about py-sm-5 py-4">
            <div class="container">
                <h2 class="title">Tur Detalları</h2>
                <ul class="breadcrumbs-custom-path mt-2">
                    <li><a href="/Home/Index">Ana Səhifə</a></li>
                    <li class="active"><span class="fa fa-arrow-right mx-2" aria-hidden="true"></span> Rəhbərin yorumları </li>
                </ul>
            </div>
        </div>
    </section>
   
    <div class="py-5 w3l-homeblock1 text-center">
        <div class="container mt-md-3">
            <h3 class="blog-desc-big text-center mb-4">
                Unudulmaz Səyahətlərə Aparan Ən Gözəl İstiqamətlər
            </h3>
            <div class="blog-post-align">
                <div class="blog-post-img">
                    <a href="#" target="_blank">
                        <img src="/AeroTrip12-Starteryeni/assets/images/MyPhotos.png"
                             alt="Akram Abaszade"
                             class="rounded-circle"
                             style="width:120px;
                height:120px;
                object-fit:cover;
                
                padding:4px;
                box-shadow:0 4px 15px rgba(0,0,0,0.25);" />
                    </a>
                </div>
                <div class="blog-post-info">
                    <div class="author align-items-center mb-1">
                        <a href="https://wa.me/994505415163" target="_blank">Akram Abaszade</a> tərəfindən • <a href="/Home/Index">AeroTrip</a>
                    </div>
                    <ul class="blog-meta">
                        <li class="meta-item blog-lesson">
                            <span class="meta-value"> @DateTime.Now.Year </span>
                        </li>
                        <li class="meta-item blog-students">
                            <span class="meta-value">6 dəqiqəlik oxu</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <section class="blog-post-main w3l-homeblock1">
        <!--/blog-post-->
        <div class="blog-content-inf pb-5">
            <div class="container pb-lg-4">
                <div class="single-post-image">
                    <div class="post-content" style="text-align:center;">
                        <img src="@Model.Image"
                             class="radius-image img-fluid mb-5"
                             alt=""
                             style="width:100%; max-width:800px; height:auto; border-radius:12px;" />
                    </div>
                </div>
                <div class="single-post-content">
                    <p class="alphabet mb-4">
                        <span class="big-letter"></span>@Model.Details1
                    </p>
                   
                    <blockquote class="blockquote my-5">
                        <div class="icon-quote"><span class="fa fa-quote-left" aria-hidden="true"></span></div>
                           Gəzmək,Tur,Səyahət,İstiqamətlər
                        <footer class="blockquote-footer mt-3">
                            Smith lara
                        </footer>
                    </blockquote>
                    
                    <div class="sing-post-thumb mb-5 row pt-3">
                        <div class="col-sm-6">
                            <a href="#url"><img src="@Model.CoverImage" style="width:400px;height:400px;" class="img-fluid radius-image" alt=""></a>
                        </div>
                        <div class="col-sm-6 mt-sm-0 mt-3">
                            <a href="#url"><img src="@Model.Image2" style="width:400px;height:400px;" class="img-fluid radius-image" alt=""></a>
                        </div>
                    </div>
                    
                    <p class="mb-4">
                      @Model.Details2
                    </p>

                  

                    <div class="d-grid left-right mt-5 pb-md-5">
                        <div class="buttons-singles tags">
                            <h4>Etiketlər :</h4>
                            <a href="#blog-tag">Səyahət</a>
                            <a href="#blog-tag">Mədəniyyət</a>
                            <a href="#blog-tag">Otel</a>
                            <a href="#blog-tag">Yemək</a>
                        </div>
                        <div class="buttons-singles">
                            <h4>Paylaş :</h4>
                            <a href="#"><i class="bi bi-facebook"></i></a>
                            <a href="#"><i class="bi bi-instagram"></i></a>
                            <a href="#"><i class="bi bi-tiktok"></i></a>
                            <a href="#"><i class="bi bi-whatsapp"></i></a>
                        </div>
                    </div>

                    <!--//author-card-->
                    @await Component.InvokeAsync("AuthorGuide")



                    @await Component.InvokeAsync("Comment", new { Id = ViewBag.i })
                </div>

                @await Component.InvokeAsync("AddComment", new { Id = ViewBag.i })
                </div>
            </div>
           
    </section>

 
</body>

