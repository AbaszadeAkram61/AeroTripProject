@model List<ResultDestination>

@{
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
}



<body>
  
   
   
    <section class="w3l-about-breadcrumb text-left">
        <div class="breadcrumb-bg breadcrumb-bg-about py-sm-5 py-4">
            <div class="container">
                <h2 class="title">İstiqamətlər </h2>
                <ul class="breadcrumbs-custom-path mt-2">
                    <li><a href="/Home/Index">Ana Səhifə</a></li>
                    <li class="active"><span class="fa fa-arrow-right mx-2" aria-hidden="true"></span> İstiqamətlər </li>
                </ul>
            </div>
        </div>
    </section>
 
    <section class="grids-1 py-5">
        <div class="grids py-lg-5 py-md-4">
            <div class="container">
                <h3 class="hny-title mb-5"> Tur İstiqamətlər</h3>
                <div class="row">
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-4 col-md-4 col-6">
                            <div class="column">
                                <a href="#"><img src="@item.Image" alt="" class="img-fluid" style="width:100%; height:250px; object-fit:cover;"></a>
                                <div class="info">
                                    <h4><a href="#">@item.City</a></h4>
                                    <p>@item.DayNight </p>
                                    <div class="dst-btm">
                                        <h6 class="">Qiymət</h6>
                                        <span>@item.Price Azn</span>
                                    </div>
                                    <a href="/Destination/DestinationDetails/@item.Id" class="detail-btn">
                                        Ətraflı 
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                 
                
                </div>
            </div>
        </div>
    </section>
    <script src="/AeroTrip12-Starteryeni/assets/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="/AeroTrip12-Starteryeni/assets/css/style-liberty.css">

</body>


