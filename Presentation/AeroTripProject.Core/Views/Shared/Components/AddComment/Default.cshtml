<div class="leave-comment-form mt-5" id="reply">
    <h4 class="side-title mb-2">Şərh yazın</h4>
    <p class="mb-4">
        E-poçt ünvanınız dərc olunmayacaq. Məcburi xanalar işarələnib 
    </p>
    <form method="post" asp-action="CreateComment" asp-controller="Comment">

        <div class="form-group">
            <textarea name="CommentContent" class="form-control" placeholder="Şərhiniz*" required=""
                      spellcheck="false"></textarea>
        </div>
        <div class="input-grids row">

           
            <div class="form-group col-lg-6">
                <input type="hidden" name="DestinationID" class="form-control" value="@ViewBag.i" required="">
            </div>
        </div>

        <div class="submit text-right">
            <button class="btn btn-style btn-primary">Şərh et</button>
        </div>
    </form>
</div>
