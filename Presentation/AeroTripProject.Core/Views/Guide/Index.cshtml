@model List<ResultGuide>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
}

<section class="w3l-team" id="team" style="padding-top:130px;">
    <div class="team-block py-5">
        <div class="container py-lg-5">
            <div class="title-content text-center mb-lg-3 mb-4">
                <h6 class="sub-title">Komandamız</h6>
                <h3 class="hny-title">Rəhbərlərimizlə Tanış Olun</h3>
            </div>
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-lg-3 col-6 mt-lg-5 mt-4">
                        <div class="box16">
                            <a href="#url"><img src="@item.Image" alt="" class="img-fluid" /></a>
                            <div class="box-content">
                                <h3 class="title"><a href="#url">@item.Name</a></h3>
                                <span class="post">@item.Description</span>
                                <ul class="social">
                                    <li>
                                        <a href="https://www.instagram.com/..." target="_blank">
                                            <i class="bi bi-instagram"></i>
                                        </a>
                                    </li>

                                    <li>
                                        <a href="https://www.tiktok.com/@@akram_1942" target="_blank">
                                            <i class="bi bi-tiktok"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                }
               
              
            </div>
        </div>
    </div>
</section>

