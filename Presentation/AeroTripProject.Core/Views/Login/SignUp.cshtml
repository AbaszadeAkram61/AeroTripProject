@{
	Layout = null;
}



<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<title>AeroTrip Qonaq Qeydiyyat Ekranı</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<!-- LINEARICONS -->
	<link rel="stylesheet" href="/AeroTrip_Login_Register/login_register/colorlib-regform-26/fonts/linearicons/style.css">

	<!-- STYLE CSS -->
	<link rel="stylesheet" href="/AeroTrip_Login_Register/login_register/colorlib-regform-26/css/style.css">
</head>

<body>

	<div class="wrapper">
		<div class="inner">
			<img src="/AeroTrip_Login_Register/login_register/colorlib-regform-26/images/image-1.png" alt="" class="image-1">
			<form action="">
				<h3>Yeni hesab</h3>
				<div class="form-holder">
					<span class="lnr lnr-user"></span>
					<input type="text" class="form-control" placeholder="Adınız">
				</div>
				<div class="form-holder">
					<span class="lnr lnr-user"></span>
					<input type="text" class="form-control" placeholder="Soyadınız">
				</div>
				<div class="form-holder">
					<span class="lnr lnr-envelope"></span>
					<input type="text" class="form-control" placeholder="Mail Ünvanınız">
				</div>
				<div class="form-holder">
					<span class="lnr lnr-phone-handset"></span>
					<input type="text" class="form-control" placeholder="Telefon Nömrəniz">
				</div>
				<div class="form-holder">
					<span class="lnr lnr-lock"></span>
					<input type="password" class="form-control" placeholder="Şifrəniz">
				</div>
				<div class="form-holder">
					<span class="lnr lnr-keyboard"></span>
					<input type="password" class="form-control" placeholder="Şifrənizi Doğrula">
				</div>
				<button>
					<span>Qeydiyyat ol</span>
				</button>
				<button>
					<span>Daxil ol</span>
				</button>
			</form>
			<img src="/AeroTrip_Login_Register/login_register/colorlib-regform-26/images/image-2.png" alt="" class="image-2">
		</div>

	</div>

	<script src="/AeroTrip_Login_Register/login_register/colorlib-regform-26/js/jquery-3.3.1.min.js"></script>
	<script src="/AeroTrip_Login_Register/login_register/colorlib-regform-26/js/main.js"></script>
</body><!-- This templates was made by Colorlib (https://colorlib.com) -->
</html>
