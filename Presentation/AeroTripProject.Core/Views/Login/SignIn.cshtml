@model UserSignIn

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">
<head>
    <title>AeroTrip | İstifadəçi Giriş Paneli</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="icon" type="image/png" href="/AeroTrip_Login_Register/login_register/Login_v1/images/icons/Favicon.png" />
    <link rel="stylesheet" type="text/css" href="/AeroTrip_Login_Register/login_register/Login_v1/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="/AeroTrip_Login_Register/login_register/Login_v1/fonts/font-awesome-4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" type="text/css" href="/AeroTrip_Login_Register/login_register/Login_v1/vendor/animate/animate.css">
    <link rel="stylesheet" type="text/css" href="/AeroTrip_Login_Register/login_register/Login_v1/vendor/css-hamburgers/hamburgers.min.css">
    <link rel="stylesheet" type="text/css" href="/AeroTrip_Login_Register/login_register/Login_v1/vendor/select2/select2.min.css">
    <link rel="stylesheet" type="text/css" href="/AeroTrip_Login_Register/login_register/Login_v1/css/util.css">
    <link rel="stylesheet" type="text/css" href="/AeroTrip_Login_Register/login_register/Login_v1/css/main.css">
</head>

<body>

    <div class="limiter">
        <div class="container-login100">
            <div class="wrap-login100">

                <div class="login100-pic">
                    <div class="pic-text">
                        <h3>Səyahətə<br>başlamaq üçün</h3>
                        <p>AeroTrip hesabınıza daxil olun və səyahətlərə başlayın.</p>
                    </div>
                </div>

                <form class="login100-form validate-form"
                      asp-action="SignIn"
                      asp-controller="Login"
                      method="post">

                    <span class="login100-form-title">
                        İstifadəçi Girişi
                    </span>

                    @if (TempData["LoginError"] != null)
                    {
                        <div id="loginError" class="alert alert-danger text-center">
                            @TempData["LoginError"]
                        </div>
                    }

                    <div class="wrap-input100">
                        <input class="input100"
                               type="text"
                               asp-for="Username"
                               placeholder="İstifadəçi adı">

                        <span asp-validation-for="Username" class="text-danger"></span>

                        <span class="focus-input100"></span>
                        <span class="symbol-input100">
                            <i class="fa fa-user" aria-hidden="true"></i>
                        </span>
                    </div>

                    <div class="wrap-input100">
                        <input class="input100"
                               type="password"
                               asp-for="Password"
                               placeholder="Parol">

                        <span asp-validation-for="Password" class="text-danger"></span>

                        <span class="focus-input100"></span>
                        <span class="symbol-input100">
                            <i class="fa fa-lock" aria-hidden="true"></i>
                        </span>
                    </div>

                    <div class="container-login100-form-btn">
                        <button class="login100-form-btn">
                            Daxil ol
                        </button>
                    </div>

                    <div class="text-center p-t-12">
                        <a class="txt2" href="/Admin/PasswordChanges/Index">
                            Şifrənizi unutmusunuz?
                        </a>
                    </div>

                    <div class="text-center p-t-136">
                        <a class="txt2" href="/Login/SignUp">
                            Hesabınız yoxdur? Qeydiyyatdan keçin
                            <i class="fa fa-long-arrow-right m-l-5" aria-hidden="true"></i>
                        </a>
                    </div>

                </form>

            </div>
        </div>
    </div>

    <script src="/AeroTrip_Login_Register/login_register/Login_v1/vendor/jquery/jquery-3.2.1.min.js"></script>
    <script src="/AeroTrip_Login_Register/login_register/Login_v1/vendor/bootstrap/js/popper.js"></script>
    <script src="/AeroTrip_Login_Register/login_register/Login_v1/vendor/bootstrap/js/bootstrap.min.js"></script>
    <script src="/AeroTrip_Login_Register/login_register/Login_v1/vendor/select2/select2.min.js"></script>
    <script src="/AeroTrip_Login_Register/login_register/Login_v1/js/main.js"></script>

    <script>
        setTimeout(function () {
            var alert = document.getElementById("loginError");

            if (alert) {
                alert.style.transition = "opacity 0.5s";
                alert.style.opacity = "0";

                setTimeout(function () {
                    alert.remove();
                }, 500);
            }
        }, 2000);
    </script>

</body>
</html>